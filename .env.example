# Anthropic API代理终端 - 环境变量示例
# 复制此文件为 .env 并填写真实的API密钥

# Anthropic官方API密钥
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI API密钥
# 获取地址: Azure门户
AZURE_OPENAI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 第三方代理服务API密钥
THIRD_PARTY_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook密钥（用于监控通知）
WEBHOOK_SECRET=your-webhook-secret-here

# HTTP代理认证信息
PROXY_USER=proxyuser
PROXY_PASS=proxypassword

# 可选：其他环境变量
# DEBUG=true
# LOG_LEVEL=DEBUG
# PROXY_URL=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1